# ─────────────────────────────────────────────
# Smart Shopping Chatbot — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

# API Base URL (no trailing slash)
API_BASE_URL=https://your-api-server.com/api/v1

# WebSocket URL (optional, for real-time features)
WS_URL=wss://your-api-server.com/ws

# Environment: dev | staging | prod
APP_ENV=dev

# API Key for Chatbot (Warning: Stored in client app)
CHATBOT_API_KEY=
