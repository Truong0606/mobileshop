# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

# API Base URL (no trailing slash)
API_BASE_URL=https://shoppe-fake-427087851138.asia-southeast1.run.app/api/v1

# WebSocket URL (optional, for real-time features)
WS_URL=wss://shoppe-fake-427087851138.asia-southeast1.run.app/ws

# Environment: dev | staging | prod
APP_ENV=dev

# API Key for Chatbot (Warning: Stored in client app)
CHATBOT_API_KEY=
