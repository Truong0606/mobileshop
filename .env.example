# ─────────────────────────────────────────────
# Smart Shopping Chatbot (Flutter Mobile) — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── 1. Backend API Base URL (ShoppeFake Backend API - no trailing slash)
API_BASE_URL=https://api.yourdomain.com/api/v1

# ── 2. Chatbot AI API Base URL
CHATBOT_API_BASE_URL=https://chatbot-api.yourdomain.com/api/v1

# ── 3. WebSocket URL (optional, for real-time features)
WS_URL=wss://chatbot-api.yourdomain.com/ws

# ── 4. App Environment: dev | staging | prod
APP_ENV=dev

# ── 5. API Key for Chatbot Service
CHATBOT_API_KEY=your_chatbot_api_key_here
